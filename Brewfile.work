brew "awscli"
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-credential-helper"
brew "googleworkspace-cli"
brew "helm"
brew "k9s" # k8s TUI (replaces Freelens)
brew "kubernetes-cli"
brew "lazysql" # DB TUI alongside DBeaverLite
brew "lazydocker"
brew "libpq" # keg-only; psql on PATH via system/_path.zsh
brew "pgformatter"
brew "pre-commit"
brew "redis"
brew "sf"
brew "sops"

# React Native / iOS
brew "aria2" # xcodes uses it for 3-5x faster Xcode downloads
brew "cocoapods"
brew "fastlane"
brew "watchman"
brew "xcodes"

# Native iOS/macOS: Xcode from nvim + agents
tap "getsentry/xcodebuildmcp"
brew "getsentry/xcodebuildmcp/xcodebuildmcp" # MCP server for claude/opencode
brew "swiftformat"
brew "swiftlint"
brew "xcbeautify" # xcodebuild output formatter (xcodebuild.nvim dep)
brew "xcode-build-server" # sourcekit-lsp <-> xcodeproj bridge (xcodebuild.nvim dep)

cask "android-studio"
cask "dbeaverlite"
cask "freelens"
cask "google-chrome"
cask "google-drive"
cask "slack"
cask "zoom"
cask "zulu@11"
cask "zulu@17"
