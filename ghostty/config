# Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Theme
theme = TokyoNight Night

# Shell
shell-integration = zsh
# ssh-env: forward TERM/terminfo over ssh (Omarchy)
shell-integration-features = no-cursor,ssh-env

# Window
window-decoration = none
macos-titlebar-style = hidden
macos-option-as-alt = true
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true 

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 3

# Selection & Clipboard
copy-on-select = clipboard
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true

# Close without confirmation
confirm-close-surface = false

# Keys (Omarchy)
# Send Shift+Enter as CSI-u so TUIs can tell it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter as Alt+Enter; CSI-u lets tmux match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u

# Quake console, Omarchy's SUPER+grave (alt is the WM modifier here).
# global: needs Accessibility permission for Ghostty.
keybind = global:alt+grave_accent=toggle_quick_terminal
quick-terminal-position = top
