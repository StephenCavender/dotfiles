# ============================================
# TMUX CONFIGURATION
# ============================================

# ----------------------------------------
# 0. PALETTE (Tokyo Night - matches ghostty, nvim, sketchybar, borders)
# ----------------------------------------
# Single source of truth for tmux colors. Referenced as #{@c_*} in formats.
# Note: tmux-pane-tree options below must stay literal hex - its Python UI
# reads raw option values and cannot expand tmux formats.
# Names kept from the old Dracula palette; @c_purple is the primary accent.
set -g @c_bg      "#1a1b26"
set -g @c_fg      "#a9b1d6"
set -g @c_line    "#414868"
set -g @c_comment "#565f89"
set -g @c_cyan    "#7dcfff"
set -g @c_green   "#9ece6a"
set -g @c_orange  "#ff9e64"
set -g @c_pink    "#bb9af7"
set -g @c_purple  "#7aa2f7"
set -g @c_red     "#f7768e"
set -g @c_yellow  "#e0af68"

# ----------------------------------------
# 1. TERMINAL & COMPATIBILITY
# ----------------------------------------
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-ghostty:RGB,xterm-256color:RGB"
set -as terminal-features ",xterm-ghostty:sixel"
set -g allow-passthrough on
set -s extended-keys on
set -g extended-keys-format csi-u
set -sg escape-time 10

# ----------------------------------------
# 2. GENERAL SETTINGS
# ----------------------------------------
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g mouse on
set -g default-shell /bin/zsh
set -g history-limit 100000
set -g focus-events on
set -g status-keys vi
set -g allow-rename off
set -g automatic-rename off
# Killing the last window of a session switches to another session instead of detaching (Omarchy)
set -g detach-on-destroy off

setw -g monitor-activity on
set -g visual-activity off

# ----------------------------------------
# 3. KEY BINDINGS
# ----------------------------------------
# Prefix: C-Space like Omarchy, C-b kept as secondary
set -g prefix C-Space
set -g prefix2 C-b
bind C-Space send-prefix

# Reload config (r kept; q matches Omarchy)
unbind r
bind r source-file ~/.tmux.conf \; display-message "tmux.conf reloaded."
bind q source-file ~/.tmux.conf \; display-message "tmux.conf reloaded."

# Keybinding help popup (Omarchy)
bind ? display-popup -E -w 80% -h 70% -T "Tmux keybindings" "tmux list-keys | less -R"

# Splits preserve current path
bind '"' split-window -v -c "#{pane_current_path}"
bind '%' split-window -h -c "#{pane_current_path}"
# Omarchy split aliases. Omarchy's M-Enter/M-S-Enter are skipped: AeroSpace
# owns alt-enter (new terminal) and alt-shift-* before tmux sees them.
bind h split-window -v -c "#{pane_current_path}"
bind v split-window -h -c "#{pane_current_path}"

# Omarchy window/session keys. x stays tmux's confirmed kill-pane; k confirms
# too (same reason M-Escape is skipped). K stays resize, so no kill-session key.
bind c new-window -c "#{pane_current_path}"
bind k confirm-before -p "kill-window #W? (y/n)" kill-window
bind R command-prompt -I "#S" "rename-session -- '%%'"
bind C new-session -c "#{pane_current_path}"
bind P switch-client -p
bind N switch-client -n

# Omarchy pane navigation / resize without prefix
bind -n C-M-Left select-pane -L
bind -n C-M-Right select-pane -R
bind -n C-M-Up select-pane -U
bind -n C-M-Down select-pane -D
bind -n C-M-S-Left resize-pane -L 5
bind -n C-M-S-Down resize-pane -D 5
bind -n C-M-S-Up resize-pane -U 5
bind -n C-M-S-Right resize-pane -R 5

# Pane resizing (repeatable with -r)
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# ----------------------------------------
# 3b. DEV LAYOUTS
# ----------------------------------------
# c/cx/cy shorthand -> opencode/claude/codex (mapped inside tdl itself, see
# ~/.dotfiles/functions/tdl - doesn't touch the `c` project-jump function)
bind D command-prompt -p "agent:" -I "opencode" "send-keys 'tdl %%' Enter"
bind S send-keys "tds" Enter
bind M command-prompt -p "agent:" -I "opencode" "send-keys 'tdlm %%' Enter"

# ----------------------------------------
# 4. COPY MODE (vi)
# ----------------------------------------
setw -g mode-keys vi
bind Enter copy-mode
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi Escape send-keys -X cancel

# ----------------------------------------
# 5. PANE IDENTIFICATION
# ----------------------------------------
# Heavy borders with title showing pane name + path
set -g pane-border-lines heavy
set -g pane-border-indicators colour
set -g pane-border-status top
set -g pane-border-format ' #{?pane_active,#[fg=#{@c_purple}],#[fg=#{@c_line}]}#{pane_title} #[fg=#{@c_line}]── #[default]#{?pane_active,#[fg=#{@c_fg}],#[fg=#{@c_comment}]}#{pane_current_path} '

set -g pane-border-style 'fg=#{@c_line}'
# Matches borders/aerospace window border accent so focus reads the same at
# both the OS-window and tmux-pane level.
set -g pane-active-border-style 'fg=#{@c_purple}'

set -g window-style 'bg=default'
set -g window-active-style 'bg=default'

# ----------------------------------------
# 5b. STATUS BAR
# ----------------------------------------
# Division of labour - the bar only shows what nothing else can:
#   pane-tree sidebar -> sessions / windows / panes / agent badges
#   starship prompt   -> git branch + dirty for the pane you type in
#   sketchybar        -> clock, battery, cpu, mem, wifi, volume, agent alerts
#   this bar          -> tmux modal state, and git for panes running an agent
set -g status on
set -g status-position bottom
set -g status-justify left
set -g status-style 'bg=default,fg=#{@c_comment}'
set -g status-interval 5
set -g status-left-length 40
set -g status-right-length 120

# The sidebar owns the window list.
set -g window-status-format ''
set -g window-status-current-format ''

set -g status-left "\
#{?client_prefix,#[fg=#{@c_bg}#,bg=#{@c_yellow}#,bold] PREFIX #[default],}\
#{?pane_in_mode,#[fg=#{@c_bg}#,bg=#{@c_cyan}#,bold] COPY #[default],}\
#{?window_zoomed_flag,#[fg=#{@c_bg}#,bg=#{@c_orange}#,bold] ZOOM #[default],}\
#{?pane_synchronized,#[fg=#{@c_bg}#,bg=#{@c_red}#,bold] SYNC #[default],}"

# Git state for agent panes only - starship already covers the pane you type in.
# Must be set before the tpm line: tmux-continuum appends its save hook to
# whatever status-right holds when it loads.
set -g status-right "#(~/.dotfiles/tmux/scripts/agent-git.sh '#{session_name}')"

set -g message-style 'bg=#{@c_line},fg=#{@c_fg}'
set -g mode-style 'bg=#{@c_purple},fg=#{@c_bg}'

# ----------------------------------------
# 6. PLUGINS
# ----------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'sandudorogan/tmux-pane-tree'

# ----------------------------------------
# 7. PLUGIN CONFIGURATION
# ----------------------------------------
# Resurrect
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
# resurrect restores the pane-tree sidebar's title/geometry but not its
# @tmux_sidebar_owned marker, so pane-tree can't recognize the restored pane
# as its own and spawns a second one. Kill the unmarked leftover post-restore.
set -g @resurrect-hook-post-restore-all 'bash ~/.dotfiles/tmux/scripts/kill-stale-sidebar-panes.sh'

# Pane Tree
set -g @tmux_pane_tree_install_agent_hooks 1
set -g @tmux_pane_tree_color_session '#7AA2F7'
set -g @tmux_pane_tree_color_window '#BB9AF7'
set -g @tmux_pane_tree_color_pane '#7DCFFF'
set -g @tmux_pane_tree_session_order "dev,ops,scratch,comms"

# ----------------------------------------
# 8. TPM INITIALIZATION (MUST BE LAST)
# ----------------------------------------
run '~/.tmux/plugins/tpm/tpm'
