#!/bin/bash

# Launched by AeroSpace (after-startup-command runs bare `borders`, which
# executes ~/.config/borders/bordersrc). Colors: Tokyo Night accent / muted.
options=(
	style=round
	width=2.0
	hidpi=off
	active_color=0xff7aa2f7
	inactive_color=0xff414868
  blacklist=""
  whitelist=""
)

borders "${options[@]}"
